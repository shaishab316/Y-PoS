# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ypos?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
OTP_SECRET=replace_with_a_random_otp_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=YPoS

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_password

# Logging
LOG_LEVEL=log
TEST_OTP=123456
LOKI_URL=http://localhost:3100

# OneSignal
ONESIGNAL_API_KEY=your_onesignal_api_key
ONESIGNAL_APP_ID=your_onesignal_app_id

# Protected Routes
DOCS_USERNAME=admin
DOCS_PASSWORD=replace_with_a_secure_password
QUEUES_USERNAME=admin
QUEUES_PASSWORD=replace_with_a_secure_password

# Production
# GRAFANA_ADMIN_PASSWORD=
# DB_PASSWORD=