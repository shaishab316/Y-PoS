model ProductionStation {
  id Int @id @default(autoincrement())

  slug String? // ps-00001

  name      String?
  sortOrder Int?
  isActive  Boolean? @default(true)

  items          Item[]
  orderItems     OrderItem[]
  packetSections PacketSection[]
  orderItemPacketChoices OrderItemPacketChoice[]

  users User[]

  @@map("production_stations")
}
