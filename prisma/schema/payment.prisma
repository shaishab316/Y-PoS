model Payment {
  id   Int     @id @default(autoincrement())
  slug String? // pay-00001

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method PaymentMethod? @default(CASH)
  status PaymentStatus? @default(PENDING)

  subtotal     Decimal? @db.Decimal(10, 2)
  chargesTotal Decimal? @default(0.00) @db.Decimal(10, 2)
  totalAmount  Decimal? @db.Decimal(10, 2)

  cashReceived Decimal? @db.Decimal(10, 2)
  changeAmount Decimal? @db.Decimal(10, 2)

  proofImages String[]

  appliedCharges Json?

  paidAt DateTime?

  isVerified Boolean? @default(false)

  verificationStatus PaymentVerificationStatus @default(PENDING)

  verifiedAt DateTime?

  verifiedById Int?
  verifiedBy   User? @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  cashierId Int?
  cashier   User? @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)

  markAsMissMatch Boolean? @default(false)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("payments")
}

enum PaymentVerificationStatus {
  PENDING
  MATCH
  MISMATCH
}

model PaymentVerify {
  id Int @id @default(autoincrement())

  date DateTime? @db.Date

  totalAmount  Decimal? @db.Decimal(10, 2)
  actualAmount Decimal? @db.Decimal(10, 2)

  remark String?

  proofImages String[]

  verifiedAt DateTime? @default(now())

  verifiedById Int?
  verifiedBy   User? @relation("PaymentVerifyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@map("payment_verifies")
}
