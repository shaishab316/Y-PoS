model OperatingHours {
  id Int @id @default(autoincrement())

  sundayStart String?
  sundayEnd   String?

  mondayStart String?
  mondayEnd   String?

  tuesdayStart String?
  tuesdayEnd   String?

  wednesdayStart String?
  wednesdayEnd   String?

  thursdayStart String?
  thursdayEnd   String?

  fridayStart String?
  fridayEnd   String?

  saturdayStart String?
  saturdayEnd   String?
}
