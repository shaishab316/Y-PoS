model User {
  id Int @id @default(autoincrement())

  slug String? // u-00001

  name String?

  role UserRole? @default(ADMIN)

  passwordHash String?

  isActive Boolean? @default(true)

  email String?

  phone String?

  photoUrl String?

  address String?

  facebookUrl String?

  instagramUrl String?

  // Password reset fields
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // OTP fields
  otp       String?
  otpExpiry DateTime?

  orders           Order[]
  shiftSessions    ShiftSession[]
  cashProofsUpload CashProof[]    @relation("CashProofUploadedBy")
  cashProofsVerify CashProof[]    @relation("CashProofVerifiedBy")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("users")
}
