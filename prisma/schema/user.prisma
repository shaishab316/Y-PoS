model User {
  id Int @id @default(autoincrement())

  slug String? // u-00001

  name String?

  role UserRole? @default(ADMIN)

  passwordHash String?

  isActive Boolean? @default(true)

  email String?

  phone String?

  photoUrl String?

  address String?

  facebookUrl String?

  instagramUrl String?

  // Password reset fields
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  feedbackMsg String?

  // OTP fields
  otp       String?
  otpExpiry DateTime?

  productionStationId Int?
  productionStation   ProductionStation? @relation(fields: [productionStationId], references: [id], onDelete: SetNull)

  orders         Order[] @relation("userOrders")
  assignedOrders Order[] @relation("assignedToOrders")

  shiftSessions    ShiftSession[]
  cashProofsUpload CashProof[]    @relation("CashProofUploadedBy")
  cashProofsVerify CashProof[]    @relation("CashProofVerifiedBy")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("users")
}
