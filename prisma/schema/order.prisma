model Order {
  id   Int     @id @default(autoincrement())
  slug String? // o-00001

  source OrderSource?
  type   OrderType?   @default(DINE_IN)
  status OrderStatus? @default(PENDING)

  customerName String?

  tableId Int?
  table   Table? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  assignedToId Int?
  assignedTo   User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  subtotal    Decimal? @default(0.00) @db.Decimal(10, 2)
  totalAmount Decimal? @default(0.00) @db.Decimal(10, 2)

  orderItems    OrderItem[]
  payment       Payment[]
  notifications Notification[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  itemId Int?
  item   Item? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  productionStationId Int?
  productionStation   ProductionStation? @relation(fields: [productionStationId], references: [id], onDelete: SetNull)

  itemName   String?
  unitPrice  Decimal? @db.Decimal(10, 2)
  promoPrice Decimal? @db.Decimal(10, 2)
  quantity   Int?     @default(1)

  status OrderStatus? @default(PENDING)

  packetChoices Json?

  isCancelled      Boolean?  @default(false)
  cancelledAt      DateTime?
  cancelReviewedBy Int?

  processedAt DateTime?
  readyAt     DateTime?
  pickedUpAt  DateTime?

  @@map("order_items")
}
